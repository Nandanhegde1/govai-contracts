---
import Layout from '../layouts/Layout.astro';

// No email list: the site sends no email, so this page points to the feeds
// that do exist (RSS for new awards, the JSON API for everything).
const rssUrl = new URL('/rss.xml', Astro.site).href;
---
<Layout
  title="Follow new federal AI contract awards (RSS &amp; JSON)"
  description="Follow new U.S. federal AI/ML contract awards with the free RSS feed or the public JSON API. No signup."
>
  <section class="hero">
    <h1>Follow new federal AI awards</h1>
    <p class="lead">
      There's no email list. To follow new AI/ML contract awards, add the RSS feed to a feed reader
      or pull the JSON API on your own schedule. Both are free and need no signup.
    </p>
  </section>

  <div class="detail-grid">
    <section class="card" style="padding: 28px;">
      <h2 class="section-title">RSS feed</h2>
      <p style="color: var(--text-muted); font-size: 14px;">
        The 50 most recent awards by start date. Each item has the recipient, amount and agency.
        The feed updates whenever the data refreshes. Paste this URL into any feed reader:
      </p>
      <p style="margin-top: 14px;"><a href="/rss.xml"><code>{rssUrl}</code></a></p>
    </section>

    <aside>
      <h2 class="section-title">JSON API</h2>
      <p style="color: var(--text-muted); font-size: 14px;">
        Every award, vendor and agency as JSON, with no key needed. The index lists each endpoint
        and when the data was last refreshed.
      </p>
      <p style="margin-top: 14px; font-size: 14px;">
        <a href="/api/v1/index.json"><code>/api/v1/index.json</code></a> · <a href="/api/">API docs</a>
      </p>
    </aside>
  </div>
</Layout>
