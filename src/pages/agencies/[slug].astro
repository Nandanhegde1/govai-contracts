---
import Layout from '../../layouts/Layout.astro';
import ContractCard from '../../components/ContractCard.astro';
import { getAgencies, getContractsByAgency } from '../../lib/data';
import { formatMoney } from '../../lib/types';

export async function getStaticPaths() {
  return getAgencies().map((a) => ({ params: { slug: a.slug }, props: { agency: a } }));
}

const { slug } = Astro.params;
const { agency } = Astro.props;
const contracts = getContractsByAgency(slug!).sort((a, b) => b.amount - a.amount);

const title = `${agency.name} AI/ML contracts`;
const description = `${agency.name} has awarded ${agency.count} AI/ML contracts worth ${formatMoney(agency.total_amount)}. See the contracts, vendors, and dollar amounts.`;
---
<Layout title={title} description={description}>
  <p style="margin-bottom: 8px;"><a href="/agencies/">← All agencies</a></p>
  <section class="hero">
    <h1>{agency.name}</h1>
    <p class="lead">
      {agency.count} AI/ML contracts · {formatMoney(agency.total_amount)} total awarded.
    </p>
    <p style="margin-top: 14px; display:flex; gap:10px; flex-wrap:wrap;">
      <a href={`/agencies/${slug}/vendors/`} style="background:var(--accent); color:#04140a; padding:8px 14px; border-radius:6px; font-weight:600; font-size:14px; text-decoration:none;">Top vendors at {agency.name} →</a>
      <a href={`/export/agency/${slug}.csv`} style="background:transparent; color:var(--text); border:1px solid var(--border-strong); padding:8px 14px; border-radius:6px; font-size:14px; text-decoration:none;">↓ Download CSV</a>
    </p>
  </section>

  <div class="list-grid">
    {contracts.map((c) => <ContractCard contract={c} />)}
  </div>
</Layout>
