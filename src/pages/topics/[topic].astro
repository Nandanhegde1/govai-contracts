---
import Layout from '../../layouts/Layout.astro';
import ContractCard from '../../components/ContractCard.astro';
import { getAll } from '../../lib/data';
import { formatMoney } from '../../lib/types';
import { TOPICS, type Topic } from '../../lib/topics';

export async function getStaticPaths() {
  return TOPICS.map((t) => ({ params: { topic: t.slug }, props: { topic: t } }));
}

interface Props { topic: Topic }
const { topic } = Astro.props as Props;

const matches = getAll().filter((c) => {
  const blob = `${c.description ?? ''} ${(c.matched_keywords ?? []).join(' ')}`.toLowerCase();
  return topic.searchTerms.some((t) => blob.includes(t));
});
const total = matches.reduce((s, c) => s + c.amount, 0);
const top = [...matches].sort((a, b) => b.amount - a.amount).slice(0, 25);

const vendorTotals = new Map<string, { name: string; slug: string; amount: number; count: number }>();
const agencyTotals = new Map<string, { name: string; slug: string; amount: number; count: number }>();
for (const c of matches) {
  const v = vendorTotals.get(c.recipient_slug) ?? { name: c.recipient, slug: c.recipient_slug, amount: 0, count: 0 };
  v.amount += c.amount; v.count += 1; vendorTotals.set(c.recipient_slug, v);
  const a = agencyTotals.get(c.agency_slug) ?? { name: c.agency, slug: c.agency_slug, amount: 0, count: 0 };
  a.amount += c.amount; a.count += 1; agencyTotals.set(c.agency_slug, a);
}
const topVendors = [...vendorTotals.values()].sort((a, b) => b.amount - a.amount).slice(0, 10);
const topAgencies = [...agencyTotals.values()].sort((a, b) => b.amount - a.amount).slice(0, 10);

const title = `${topic.name} federal contracts — who's winning`;
const description = `${matches.length} federal contracts for ${topic.name.toLowerCase()} totaling ${formatMoney(total)}. Top vendors, agencies, and biggest awards.`;
---
<Layout title={title} description={description}>
  <p style="margin-bottom: 8px;"><a href="/topics/">← All AI topics</a></p>
  <section class="hero">
    <h1>{topic.name}</h1>
    <p class="lead">{topic.description}</p>
    <p style="margin-top:12px; opacity:.85;">
      <strong>{matches.length.toLocaleString()}</strong> contracts ·
      <strong>{formatMoney(total)}</strong> total ·
      across <strong>{agencyTotals.size}</strong> agencies and <strong>{vendorTotals.size}</strong> vendors.
    </p>
  </section>

  {matches.length === 0 ? (
    <p style="margin-top: 32px;">No matching contracts in the current dataset.</p>
  ) : (
    <>
      <section style="margin-top: 32px; display:grid; grid-template-columns: 1fr 1fr; gap: 24px;">
        <div>
          <h2>Top vendors</h2>
          <ol style="padding-left: 20px; line-height: 1.8;">
            {topVendors.map((v) => (
              <li>
                <a href={`/vendors/${v.slug}/`} style="color: var(--accent);">{v.name}</a>
                <span style="opacity: .7;"> — {formatMoney(v.amount)} ({v.count})</span>
              </li>
            ))}
          </ol>
        </div>
        <div>
          <h2>Top agencies</h2>
          <ol style="padding-left: 20px; line-height: 1.8;">
            {topAgencies.map((a) => (
              <li>
                <a href={`/agencies/${a.slug}/`} style="color: var(--accent);">{a.name}</a>
                <span style="opacity: .7;"> — {formatMoney(a.amount)} ({a.count})</span>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section style="margin-top: 32px;">
        <h2>Biggest awards</h2>
        <div class="list-grid">
          {top.map((c) => <ContractCard contract={c} />)}
        </div>
      </section>
    </>
  )}
</Layout>

<style>
  @media (max-width: 768px) {
    section[style*="grid-template-columns"] { grid-template-columns: 1fr !important; }
  }
</style>
