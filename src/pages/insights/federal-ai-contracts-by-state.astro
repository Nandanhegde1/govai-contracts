---
import Layout from '../../layouts/Layout.astro';
import { getStateList, getMeta } from '../../lib/data';
import { formatMoney, formatDate } from '../../lib/types';

const states = getStateList();
const meta = getMeta();
const total = states.reduce((s, x) => s + x.total_amount, 0);
const top5Share = states.slice(0, 5).reduce((s, x) => s + x.total_amount, 0) / total;
---
<Layout
  title="Where federal AI contracts go: state-by-state breakdown"
  description="Federal AI/ML contracts ranked by state. See which states host the most AI-winning vendors. Live data, updated every 6 hours."
>
  <p style="margin-bottom: 8px;"><a href="/insights/">← All insights</a></p>
  <article>
    <h1>Where federal AI contracts go: state-by-state breakdown</h1>
    <p style="color: var(--text-dim); font-size: 13px;">Updated {formatDate(meta.generated_at)} · Live data</p>

    <p class="lead" style="margin-top: 18px;">
      Federal AI dollars cluster heavily near D.C. The top 5 states alone capture
      <strong>{(top5Share * 100).toFixed(1)}%</strong> of all federal AI/ML contract dollars
      (place-of-performance basis). Here's the full ranking.
    </p>

    <h2 class="section-title">All states ranked by AI/ML contract dollars</h2>
    <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
      <thead>
        <tr style="border-bottom: 1px solid var(--border-strong); text-align: left;">
          <th style="padding: 10px 8px;">#</th>
          <th style="padding: 10px 8px;">State</th>
          <th style="padding: 10px 8px; text-align: right;">Contracts</th>
          <th style="padding: 10px 8px; text-align: right;">Total awarded</th>
        </tr>
      </thead>
      <tbody>
        {states.map((s, i) => (
          <tr style="border-bottom: 1px solid var(--border);">
            <td style="padding: 10px 8px; color: var(--text-dim);">{i + 1}</td>
            <td style="padding: 10px 8px;"><a href={`/states/${s.code.toLowerCase()}/`} style="color: var(--text);">{s.name}</a> <span style="color: var(--text-dim);">({s.code})</span></td>
            <td style="padding: 10px 8px; text-align: right; font-variant-numeric: tabular-nums;">{s.count}</td>
            <td style="padding: 10px 8px; text-align: right; font-weight: 600; font-variant-numeric: tabular-nums; color: var(--accent);">{formatMoney(s.total_amount)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </article>
</Layout>
