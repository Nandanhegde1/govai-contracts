---
import Layout from '../layouts/Layout.astro';

const ALERTS_EMAIL = 'nandanhegde1096.com'.replace('.com', '@gmail.com'); // simple obfuscation
const action = `https://formsubmit.co/nandanhegde1096@gmail.com`;
---
<Layout
  title="Request a correction or addition"
  description="Spotted an error in a GovAI Contracts listing, or want to add your company's website, logo, or details? Send a free correction request."
>
  <section class="hero">
    <h1>Request a correction or addition</h1>
    <p class="lead">
      We index public USAspending.gov data, so a listing can be incomplete or off. Spotted an error, or want to
      add your company's website, logo, or capability statement? Send us the details. Free, takes 60 seconds.
    </p>
  </section>

  <div class="detail-grid">
    <section class="card" style="padding: 28px;">
      <form action={action} method="POST">
        <input type="hidden" name="_subject" value="Listing correction / addition request" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_captcha" value="true" />
        <input type="hidden" name="_next" value="https://govai-contracts.nandanhegde1096.workers.dev/claim/?ok=1" />

        <label style="display:block; font-size:14px; color:var(--text-muted); margin-bottom:6px;">Your company name (as listed)</label>
        <input id="vendor" type="text" name="vendor" required placeholder="ACME Federal Solutions, LLC"
          style="background:var(--bg); color:var(--text); border:1px solid var(--border-strong); border-radius:4px; padding:12px 14px; font-size:15px; width:100%; margin-bottom: 14px;" />

        <label style="display:block; font-size:14px; color:var(--text-muted); margin-bottom:6px;">Your work email</label>
        <input type="email" name="email" required placeholder="you@yourcompany.com"
          style="background:var(--bg); color:var(--text); border:1px solid var(--border-strong); border-radius:4px; padding:12px 14px; font-size:15px; width:100%; margin-bottom: 14px;" />

        <label style="display:block; font-size:14px; color:var(--text-muted); margin-bottom:6px;">Company website</label>
        <input type="url" name="website" placeholder="https://yourcompany.com"
          style="background:var(--bg); color:var(--text); border:1px solid var(--border-strong); border-radius:4px; padding:12px 14px; font-size:15px; width:100%; margin-bottom: 14px;" />

        <label style="display:block; font-size:14px; color:var(--text-muted); margin-bottom:6px;">Capability statement / 1-line pitch</label>
        <textarea name="pitch" rows="3" placeholder="What do you do? What AI/ML problems do you solve for federal customers?"
          style="background:var(--bg); color:var(--text); border:1px solid var(--border-strong); border-radius:4px; padding:12px 14px; font-size:15px; width:100%; margin-bottom: 18px; font-family:inherit;"></textarea>

        <button type="submit" style="background:var(--accent); color:#04140a; border:0; border-radius:4px; padding:12px 22px; font-weight:700; font-size:15px; cursor:pointer;">
          Send request →
        </button>

        <p style="margin-top: 14px; font-size: 12px; color: var(--text-dim);">
          We'll reply within 1 business day to verify ownership and update your profile.
        </p>
      </form>
    </section>

    <aside>
      <h2 class="section-title">What you can request</h2>
      <ul style="color: var(--text-muted); font-size: 14px; line-height: 1.7; padding-left: 18px;">
        <li>Fix an error in your company's listing</li>
        <li>Add your website, logo, capability statement, or NAICS</li>
        <li>Flag a contract that's miscategorized or missing</li>
        <li>Always free — no account, no credit card</li>
      </ul>

      <h2 class="section-title" style="margin-top: 24px;">Who's this for?</h2>
      <p style="color: var(--text-muted); font-size: 14px;">
        Federal AI/ML vendors, primes, subs, and SBIR awardees. If your name appears on
        <a href="/vendors/">our vendors list</a>, you qualify.
      </p>
    </aside>
  </div>
</Layout>

<script is:inline>
  // Prefill vendor name from ?vendor= query
  const v = new URLSearchParams(location.search).get('vendor');
  if (v) {
    const el = document.getElementById('vendor');
    if (el) el.value = v;
  }
  if (new URLSearchParams(location.search).get('ok')) {
    const main = document.querySelector('.main');
    if (main) {
      const div = document.createElement('div');
      div.style.cssText = 'background: rgba(74,222,128,0.12); border: 1px solid #4ade80; color: #4ade80; padding: 14px 18px; border-radius: 6px; margin-bottom: 18px;';
      div.textContent = '✓ Request received. We\u2019ll review and update the listing within 1 business day.';
      main.insertBefore(div, main.firstChild);
    }
  }
</script>
