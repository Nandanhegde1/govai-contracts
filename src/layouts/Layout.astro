---
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = 'Track federal AI and machine learning contracts. Find who is winning AI work at DoD, DHS, NIH, NASA and more. Free, weekly updated.',
  canonical,
  ogImage = '/og-default.svg',
  jsonLd,
} = Astro.props;

const siteName = 'GovAI Contracts';
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
const url = canonical ?? Astro.url.href;

// Default org schema always present; pages can pass page-specific schema via `jsonLd`.
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteName,
  url: 'https://govai-contracts.nandanhegde1096.workers.dev/',
  description: 'Free, independent index of U.S. federal AI/ML contract awards.',
  sameAs: ['https://github.com/Nandanhegde1/govai-contracts'],
};
const extraSchemas = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
const allSchemas = [orgSchema, ...extraSchemas];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={url} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).toString()} />

    <link rel="alternate" type="application/rss+xml" title="GovAI Contracts — Latest awards" href="/rss.xml" />

    {allSchemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}

    <script defer data-domain="govai-contracts.nandanhegde1096.workers.dev" src="https://plausible.io/js/script.js"></script>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="brand" href="/">
          <span class="brand-mark">⚙</span>
          <span class="brand-name">GovAI Contracts</span>
        </a>
        <nav class="nav">
          <a href="/ask/">Ask GovAI</a>
          <a href="/contracts/">Contracts</a>
          <a href="/opportunities/">Opportunities</a>
          <a href="/agencies/">Agencies</a>
          <a href="/vendors/">Vendors</a>
          <a href="/topics/">Topics</a>
          <a href="/insights/">Insights</a>
          <a href="/alerts/">Alerts</a>
        </nav>
      </div>
    </header>

    <main class="container main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>
          GovAI Contracts · Federal AI/ML award intelligence · Data from
          <a href="https://api.usaspending.gov/" rel="noopener" target="_blank">USAspending.gov</a>
          and
          <a href="https://sam.gov/data-services" rel="noopener" target="_blank">SAM.gov</a>
          (public domain). Independent project, not affiliated with the U.S. government.
        </p>
        <p class="meta">Updated every 6 hours · <a href="/ask/">Ask GovAI</a> · <a href="/about/">About</a> · <a href="/methodology/">Methodology</a> · <a href="/insights/">Insights</a> · <a href="/topics/">Topics</a> · <a href="/years/">Years</a> · <a href="/compare/">Compare</a> · <a href="/api/">API</a> · <a href="/rss.xml">RSS</a> · <a href="https://github.com/Nandanhegde1/govai-contracts" rel="noopener" target="_blank">Source on GitHub</a></p>
        <p class="meta">Built by <a href="https://nandanhegde1.github.io/portfolio/" rel="noopener" target="_blank">Nandan Hegde</a> · <a href="https://www.linkedin.com/in/nandanhegde1096/" rel="noopener" target="_blank">LinkedIn</a></p>
      </div>
    </footer>
  </body>
</html>
